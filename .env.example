# =============================================
# MySkin Today - 环境变量示例
# =============================================
# 复制此文件为 .env.local (本地开发) 或 .env.production (生产部署)

# ===== 数据库 =====
# 本地开发 (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# Docker Compose / 生产 PostgreSQL 配置（切勿使用默认口令）
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD"
POSTGRES_DB="skin_advisor"

# ===== AI 服务 =====
# 文本 AI：qwen-turbo 全天最低价（DeepSeek 峰谷定价后更贵）
AI_PROVIDER="qwen"
# 视觉 AI：qwen-vl-plus 性价比最高
AI_VISION_PROVIDER="qwen"

# ===== NIHPLOD SSO 配置 =====
# 在官网后台 /admin/oauth-clients 注册 Public Client 后填入
NEXT_PUBLIC_SSO_CLIENT_ID="q6n4aitms0wgn2sz1nj96au5"
NEXT_PUBLIC_SSO_BASE_URL="https://nihplod.cn"
NEXT_PUBLIC_SSO_REDIRECT_URI="https://advisor.nihplod.cn/api/auth/callback"
NEXT_PUBLIC_SSO_SCOPES="openid profile phone"
# Public Client 不需要 SSO_CLIENT_SECRET；只有 Confidential Client / BFF 模式才需要
# SSO_CLIENT_SECRET=""

# ===== 官方后端地址 =====
# 保留用于调用官网非认证类接口或内部 API，示例：
# OFFICIAL_API_URL="https://nihplod.cn"
OFFICIAL_API_URL=""

# 官方 API 响应签名密钥（HMAC-SHA256）
# 若官网某些接口返回 x-official-signature 头，可用此密钥校验响应真实性。
# 当前子站代理的官网认证接口（登录/注册/资料/微信等）不返回该签名头，因此这些接口不再强制要求配置。
# 未配置时跳过校验（生产环境如官网扩展了签名响应，建议配置并保持一致）。
OFFICIAL_API_SECRET=""
# 签名头名称，默认 x-official-signature，需与 nihplod.cn 主站保持一致。
OFFICIAL_API_SIGNATURE_HEADER=""

# API Keys (至少配置一个)
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""

# ===== 安全 =====
# 重要: 以下 secret 应使用强随机字符串生成，建议命令:
#   openssl rand -base64 32
# 最小长度: 32 字符
# 切勿使用示例中的占位符值直接部署到生产环境

# [已废弃] 子站 C 端登录已迁移到 NIHPLOD SSO，不再需要 JWT_SECRET。
# 如仍有旧代码引用，可保留为空。新代码应使用 @nihplod/sso-sdk 处理登录态。
JWT_SECRET="CHANGE_ME_$(openssl rand -base64 32)"
ADMIN_SESSION_SECRET="CHANGE_ME_$(openssl rand -base64 32)"
IP_HASH_SALT="CHANGE_ME_$(openssl rand -base64 32)"
CRON_SECRET="CHANGE_ME_$(openssl rand -base64 32)"

# ===== 阿里云 OSS (可选，用于生产环境图片存储) =====
ALI_OSS_REGION=""
ALI_OSS_ACCESS_KEY_ID=""
ALI_OSS_ACCESS_KEY_SECRET=""
ALI_OSS_BUCKET=""
ALI_OSS_PUBLIC_DOMAIN=""

# ===== 微信集成 (可选) =====
# advisor 子站不再直接处理微信登录和模板消息，相关功能由官网代理。
# 以下配置仅在需要保留本地微信 Webhook 或未来扩展时使用。
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_TOKEN=""

# 内部 API 密钥（用于调用官网内部接口，如微信模板消息推送）
#
# 新版（推荐）：按项目分发的多密钥 + HMAC-SHA256 签名，用于 /api/v1/internal/*
# 子站 project 固定为 "advisor"，key/secret 需与官网主站 INTERNAL_API_KEYS 中对应条目一致
# 生成命令：npx tsx ../nihplod.cn/scripts/generate-internal-api-keys.ts
INTERNAL_API_KEYS='[{"project":"advisor","key":"advisor-key","secret":"advisor-secret-min-32-chars"}]'
#
# 旧版：单一共享密钥，用于 /api/internal/*（已废弃，仅作为极端回退保留）
# INTERNAL_API_SECRET=""

# ===== 管理员与系统安全 =====
ADMIN_SECRET="your-admin-cleanup-secret-here"
SETUP_SECRET="your-setup-secret-here"
# 警告: ADMIN_INITIAL_PASSWORD 仅在首次设置时使用。
# 设置完成后应立即从环境变量中移除，并使用 admin 面板管理密码。
ADMIN_INITIAL_PASSWORD="CHANGE_ME_TO_A_STRONG_INITIAL_PASSWORD"

# ===== Push Notifications (可选) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ===== AI 服务商自定义地址 (可选) =====
DEEPSEEK_API_URL=""
QWEN_API_URL=""

# ===== 模型与功能开关 =====
AI_MODEL=""
AI_VISION_MODEL=""
AI_ENABLED="true"
AI_QUEUE_MAX_CONCURRENT="5"

# ===== AI 预算熔断（生产必配）=====
# 当全局每日/每月估算费用达到阈值时，自动拒绝新的 AI 调用，防止账单失控。
AI_DAILY_BUDGET="50"
AI_MONTHLY_BUDGET="500"
# 留空或 0 表示该维度不限制。建议按实际业务规模调整。

# ===== 数据库直连（PostgreSQL 生产环境） =====
DIRECT_URL=""

# ===== 站点地址与主机标识 =====
# 子站公开访问地址，微信授权流程中用于告知官网回调跳回的域名
# 示例：https://advisor.nihplod.cn
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_BASE_URL=""
HOSTNAME=""

# ===== 微信模板消息 =====
WECHAT_TEMPLATE_ID=""

# ===== SEO & 分析 =====
# 百度站长验证 code (ziyuan.baidu.com → HTML 标签验证)
BAIDU_SITE_VERIFICATION=""
# 百度统计 ID (tongji.baidu.com → 获取代码中 hm.js? 后的值)
BAIDU_TONGJI_ID=""
# 百度主动推送 Token (ziyuan.baidu.com → 普通收录 → 接口调用)
BAIDU_PUSH_TOKEN=""

# Google Search Console 验证 code (search.google.com/search-console → HTML 标签)
GOOGLE_SITE_VERIFICATION=""
# Google Analytics GA4 衡量 ID (格式: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""
