# =============================================
# MySkin Today - 环境变量示例
# =============================================
# 复制此文件为 .env.local (本地开发) 或 .env.production (生产部署)

# ===== 数据库 =====
# 本地开发 (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# 生产环境 (Supabase PostgreSQL) - 取消注释并填写:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ===== AI 服务 =====
AI_PROVIDER="deepseek"
AI_VISION_PROVIDER="qwen"

# ===== 官方后端地址 =====
# 代理登录/注册/资料接口的目标地址，示例：
# OFFICIAL_API_URL="https://nihplod.cn"
OFFICIAL_API_URL=""

# API Keys (至少配置一个)
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""

# ===== Supabase Storage (生产环境图片存储) =====
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ===== 安全 =====
# 重要: JWT_SECRET 必须与官网(nihplod.cn)保持完全一致，以确保能正确解密官网下发的微信绑定 Token
JWT_SECRET="your-secret-key-here"
ADMIN_SESSION_SECRET="your-admin-session-secret-here"
IP_HASH_SALT="your-ip-hash-salt-here"
CRON_SECRET="your-cron-secret-here"

# ===== 头像生成 (可选) =====
WANXIANG_API_KEY=""
VOLC_ACCESSKEY=""
VOLC_SECRETKEY=""

# ===== 阿里云 OSS (可选，用于生产环境图片存储) =====
ALI_OSS_REGION=""
ALI_OSS_ACCESS_KEY_ID=""
ALI_OSS_ACCESS_KEY_SECRET=""
ALI_OSS_BUCKET=""
ALI_OSS_PUBLIC_DOMAIN=""

# ===== 微信集成 (可选) =====
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_TOKEN=""
WECHAT_TEMPLATE_ID=""

# ===== 管理员与系统安全 =====
ADMIN_SECRET="your-admin-cleanup-secret-here"
SETUP_SECRET="your-setup-secret-here"
ADMIN_INITIAL_PASSWORD="your-initial-admin-password-here"

# ===== Push Notifications (可选) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ===== AI 服务商自定义地址 (可选) =====
DEEPSEEK_API_URL=""
QWEN_API_URL=""
