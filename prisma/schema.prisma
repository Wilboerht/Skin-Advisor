
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// AI 护肤顾问 - 问题配置
model AdvisorQuestion {
  id        String   @id @default(cuid())
  question  String   // 问题内容
  fieldName String   @unique // 字段名 (skinType, concern, etc)
  type      String   @default("single") // single, multiple
  options   Json     // 选项列表 [{ value: 'dry', label: '干性肌肤' }]
  order     Int      @default(0) // 排序
  active    Boolean  @default(true) // 是否启用
  required  Boolean  @default(true)
  category  String   @default("general")
  gender    String   @default("all") // male, female, all
  updatedAt DateTime @updatedAt
}

// AI 顾问用户会话 - 行为追踪
model AdvisorSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique // 前端生成的会话ID
  
  // ===== 时间戳追踪 =====
  startedAt               DateTime? // 会话开始时间
  questionnaireStartedAt  DateTime? // 问卷开始时间
  questionnaireCompletedAt DateTime? // 问卷完成时间
  faceScanStartedAt       DateTime? // 面部扫描开始时间
  faceScanCompletedAt     DateTime? // 面部扫描完成时间
  analysisStartedAt       DateTime? // 分析开始时间
  analysisCompletedAt     DateTime? // 分析完成时间
  resultViewedAt          DateTime? // 结果查看时间
  completedAt             DateTime? // 完成时间
  expiresAt               DateTime? // 数据过期时间 (1个月后自动清理)
  
  // ===== 问卷数据 =====
  answers         Json?     // 问卷答案
  
  // ===== 面部扫描 =====
  faceScanUsed    Boolean   @default(false)
  faceScanSkipped Boolean   @default(false)
  
  // ===== 分析结果 =====
  analysisSource  String?   // ai | fallback
  analysisResult  Json?     // 分析结果快照
  interactions    Json?     // 用户交互记录 (如点击产品)
  
  // ===== 分享状态 =====
  resultShared    Boolean   @default(false)
  shareMethod     String?   // image | link | weibo | wechat | xiaohongshu | douyin
  
  // ===== 设备信息 =====
  userAgent       String?   // 用户代理
  ip              String?   // IP地址（脱敏后）
  deviceType      String?   // desktop | mobile | tablet
  browser         String?   // chrome | safari | firefox | edge
  os              String?   // windows | macos | linux | android | ios
  
  // ===== 地理位置 =====
  province        String?   // 省份
  city            String?   // 城市
  
  // ===== 来源追踪 =====
  referrer        String?   // 来源页面
  fingerprint     String?   // 浏览器指纹（用于去重）
  utmSource       String?   // UTM来源
  utmMedium       String?   // UTM媒介
  utmCampaign     String?   // UTM活动
  
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])

  createdAt       DateTime  @default(now())
}


// 系统设置 (用于动态配置提示词等)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// AI 顾问对话记录
model Conversation {
  id              String                @id @default(cuid())
  sessionId       String                // 关联的会话 ID (AdvisorSession.sessionId)
  messages        ConversationMessage[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([sessionId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user, assistant, system
  content        String
  createdAt      DateTime     @default(now())
}

// 推荐规则引擎
model RecommendationRule {
  id          String   @id @default(cuid())
  name        String
  priority    Int      @default(0)
  conditions  Json     // { skinType: ['oily'], concern: ['acne'] }
  productIds  Json     // string[]
  message     String?  // 推荐理由
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== CMS 新增模型 =====

// 管理员用户
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // 加密后的密码
  name      String?
  role      String   @default("admin") // super_admin, editor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  auditLogs AdminAuditLog[]
}

// 管理员操作审计日志
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String   // create, update, delete, login, logout, batch_delete, etc.
  resource    String   // Product, Question, Reward, Settings, etc.
  resourceId  String?  // ID of affected resource (if applicable)
  details     Json?    // Additional details (old value, new value, etc.)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// 普通用户 (C端)
model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  phoneNumber     String?          @unique
  password        String
  name            String?
  role            String           @default("user")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Relations
  advisorSessions AdvisorSession[]
  shareRewards    ShareReward[]
  wishlists       Wishlist[]
  pushSubscriptions PushSubscription[]
  reminderSettings  ReminderSettings?
}

// 产品库
model Product {
  id                String   @id @default(cuid())
  name              String
  nameEn            String?
  category          String   // 精华, 面霜, etc.
  image             String
  price             String
  description       String
  keyIngredients    Json     // string[] 核心成分
  suitableSkinTypes Json     // string[] 适用肤质
  benefits          Json     // string[] 主要功效
  active            Boolean  @default(true)
  stock             Int      @default(100) // Default stock
  featured          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ===== 新增字段 =====
  step              String?  // 护肤步骤: cleanser, toner, serum, eye_cream, cream, sunscreen, mask, oil
  howToUse          String?  // 使用方法说明
  affiliateLinks    Json?    // 电商链接 { taobao: "", jd: "", xiaohongshu: "", douyin: "" }
  ingredientDetails Json?    // 详细成分解读 [{ name: "烟酰胺", effect: "美白提亮", concentration: "5%" }]
  
  // Relations
  wishlistItems     WishlistItem[]
}

// 心愿单
model Wishlist {
  id        String         @id @default(cuid())
  userId    String?        // 已登录用户关联
  guestId   String?        // 未登录用户 (localStorage fingerprint)
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId])
  @@index([guestId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())
  note       String?  // 用户备注

  @@unique([wishlistId, productId])
}

// 分享领奖记录
model ShareReward {
  id            String    @id @default(cuid())
  name          String
  phone         String
  address       String
  shareProofUrl String    // 截图 URL
  skinScore     Int?
  percentile    Int?
  status        String    @default("pending") // pending, approved, rejected, shipped
  trackingNo    String?   // 快递单号
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
}

// 分享领奖活动配置
model Campaign {
  id                  String        @id @default(cuid())
  name                String        // 活动名称
  description         String?       // 活动描述
  rewardType          String        @default("sample") // sample, coupon, gift
  rewardDescription   String?       // 奖品描述
  startDate           DateTime      // 活动开始时间
  endDate             DateTime      // 活动结束时间
  isActive            Boolean       @default(true)
  maxParticipants     Int?          // 最大参与人数 (可选)
  currentParticipants Int           @default(0)
  rules               String?       // 活动规则说明
  bannerImage         String?       // 活动横幅图片
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  rewards             ShareReward[]
}

// Web Push 订阅
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      Json     // { p256dh: string, auth: string }
  userId    String?  // Optional: Link to logged-in user
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 护肤提醒设置
model ReminderSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(false)
  morningTime     String   @default("07:30")
  eveningTime     String   @default("21:00")
  morningEnabled  Boolean  @default(true)
  eveningEnabled  Boolean  @default(true)
  timezone        String   @default("Asia/Shanghai")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WeatherCache {
  id          String   @id @default(cuid())
  locationKey String   @unique // "121.39,31.25"
  data        String   // JSON stringified SkinEnvData
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

