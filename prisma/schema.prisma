
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// AI 顾问用户会话 - 行为追踪
model AdvisorSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique // 前端生成的会话ID
  
  // ===== 时间戳追踪 =====
  startedAt               DateTime? // 会话开始时间
  questionnaireStartedAt  DateTime? // 问卷开始时间
  questionnaireCompletedAt DateTime? // 问卷完成时间
  faceScanStartedAt       DateTime? // 面部扫描开始时间
  faceScanCompletedAt     DateTime? // 面部扫描完成时间
  analysisStartedAt       DateTime? // 分析开始时间
  analysisCompletedAt     DateTime? // 分析完成时间
  resultViewedAt          DateTime? // 结果查看时间
  completedAt             DateTime? // 完成时间
  expiresAt               DateTime? // 数据过期时间 (1个月后自动清理)
  
  // ===== 问卷数据 =====
  answers         Json?     // 问卷答案
  
  // ===== 面部扫描 =====
  faceScanUsed    Boolean   @default(false)
  faceScanSkipped Boolean   @default(false)
  
  // ===== 分析结果 =====
  analysisSource  String?   // ai | fallback
  analysisResult  Json?     // 分析结果快照
  interactions    Json?     // 用户交互记录 (如点击产品)
  
  // ===== 分享状态 =====
  resultShared    Boolean   @default(false)
  shareMethod     String?   // image | link | weibo | wechat | xiaohongshu | douyin
  
  // ===== 设备信息 =====
  userAgent       String?   // 用户代理
  ip              String?   // IP地址（脱敏后）
  deviceType      String?   // desktop | mobile | tablet
  browser         String?   // chrome | safari | firefox | edge
  os              String?   // windows | macos | linux | android | ios
  
  // ===== 地理位置 =====
  province        String?   // 省份
  city            String?   // 城市
  
  // ===== 来源追踪 =====
  referrer        String?   // 来源页面
  fingerprint     String?   // 浏览器指纹（用于去重）
  utmSource       String?   // UTM来源
  utmMedium       String?   // UTM媒介
  utmCampaign     String?   // UTM活动
  
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())

  // ===== 隐私同意 =====
  privacyConsentAt    DateTime?
  privacyConsentVersion String?

  // ===== 性能索引 =====
  @@index([userId])              // JOIN User 加速
  @@index([createdAt])           // 时间范围查询加速
  @@index([expiresAt])           // 清理任务按过期时间过滤
  @@index([completedAt])         // 历史记录查询加速
}


// 系统设置 (用于动态配置提示词等)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// 推荐规则引擎
model RecommendationRule {
  id          String   @id @default(cuid())
  name        String
  priority    Int      @default(0)
  conditions  Json     // { skinType: ['oily'], concern: ['acne'] }
  message     String?  // 推荐理由
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联产品（中间表）
  products    RecommendationRuleProduct[]

  @@index([active, priority])
}

// 推荐规则与产品的中间表（替代 JSON 数组，解决 N+1 和批量更新问题）
model RecommendationRuleProduct {
  id        String   @id @default(cuid())
  ruleId    String
  productId String
  rule      RecommendationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([ruleId, productId])
  @@index([productId])
}

// ===== CMS 新增模型 =====

// 管理员用户
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  password  String   // 加密后的密码
  name      String?
  // NOTE: role should ideally be an enum (super_admin, admin).
  // Kept as String for broader database compatibility.
  role             String    @default("admin")
  active           Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs AdminAuditLog[]
}

// 管理员操作审计日志
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String   // create, update, delete, login, logout, batch_delete, etc.
  resource    String   // Product, Question, Reward, Settings, etc.
  resourceId  String?  // ID of affected resource (if applicable)
  details     Json?    // Additional details (old value, new value, etc.)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([resource, resourceId])
  @@index([action, createdAt])
  @@index([adminId, createdAt])
}

// 普通用户 (C端)
model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  phoneNumber     String?          @unique
  password        String?
  name            String?
  
  avatarUrl       String?

  // NOTE: role should ideally be an enum (user, disabled).
  // Kept as String for broader database compatibility.
  role            String           @default("user")
  previousRole    String?          // 禁用前的角色，用于恢复
  dailyTestLimit  Int              @default(10) // 每日测试次数限制，管理员可调整（系统默认 10 次）
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Relations
  advisorSessions AdvisorSession[]
  pushSubscriptions PushSubscription[]
  reminderSettings  ReminderSettings?
  testRecords       TestRecord[]
  campaignEntries   CampaignEntry[]

  // 隐私同意
  privacyConsentAt     DateTime?
  privacyConsentVersion String?
}

// 测试次数记录
model TestRecord {
  id        String   @id @default(cuid())
  userId    String?  // 登录用户
  guestId   String?  // 游客 (浏览器指纹)
  testDate  DateTime @default(now()) // 测试日期
  sessionId String?  @unique // 关联的会话ID
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, testDate])
  @@index([guestId, testDate])
}

// 游客使用记录 - 多维度防滥用
model GuestUsage {
  id            String   @id @default(cuid())
  
  // ===== 多维度标识 =====
  ipAddress     String   // IP 地址
  cookieId      String?  // Cookie 标识
  fingerprint   String?  // 浏览器指纹
  
  // ===== 使用统计 =====
  testCount     Int      @default(0)     // 总测试次数
  todayCount    Int      @default(0)     // 今日测试次数
  lastTestAt    DateTime?                // 最后测试时间
  lastResetDate DateTime @default(now()) // 上次重置日期 (每日重置todayCount)
  
  // ===== 设备信息 =====
  userAgent     String?  // User-Agent
  deviceType    String?  // desktop | mobile | tablet
  browser       String?  // 浏览器类型
  os            String?  // 操作系统
  
  // ===== 风险标记 =====
  riskScore     Int      @default(0)     // 风险分数 (0-100)
  isBlocked     Boolean  @default(false) // 是否被封禁
  blockedReason String?                  // 封禁原因
  blockedAt     DateTime?                // 封禁时间

  // 隐私同意记录
  privacyConsentAt DateTime?
  privacyConsentVersion String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ipAddress])
  @@index([cookieId])
  @@index([fingerprint])
  @@index([lastTestAt])
  @@index([ipAddress, lastTestAt])
  @@index([isBlocked])           // 封禁状态过滤加速
  @@index([lastResetDate])       // 每日限额重置加速
}

// 产品库
model Product {
  id                String   @id @default(cuid())
  name              String
  nameEn            String?
  category          String   // 精华, 面霜, etc.
  image             String
  images            Json?    // string[] 产品图库（最多5张）
  price             String
  description       String
  keyIngredients    Json     // string[] 核心成分
  suitableSkinTypes Json     // string[] 适用肤质
  benefits          Json     // string[] 主要功效
  active            Boolean  @default(true)
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ===== 新增字段 =====
  howToUse          String?  // 使用方法说明
  affiliateLinks    Json?    // 电商链接 { taobao: "", jd: "", xiaohongshu: "", douyin: "" }
  negativeFor       Json     // string[] 不适合人群/负面标签，如 ["敏感肌", "痘痘肌", "孕妇"]

  // Relations
  recommendationRules RecommendationRuleProduct[]

  // ===== 常用查询索引 =====
  @@index([category])
  @@index([active, featured])
  @@index([active, category]) // 产品列表组合过滤
}



// Web Push 订阅
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      Json     // { p256dh: string, auth: string }
  userId    String?  // Optional: Link to logged-in user
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===== 性能索引 =====
  @@index([userId])              // 关联用户查询加速
}

// 护肤提醒设置
model ReminderSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(false)
  morningTime     String   @default("07:30")
  eveningTime     String   @default("21:00")
  morningEnabled  Boolean  @default(true)
  eveningEnabled  Boolean  @default(true)
  timezone        String   @default("Asia/Shanghai")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WeatherCache {
  id          String   @id @default(cuid())
  locationKey String   @unique // "121.39,31.25"
  data        String   // JSON stringified SkinEnvData
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// 应用实例注册表 — 用于检测多实例部署（限流兼容性告警）
model AppInstance {
  id        String   @id  // hostname-pid-启动时间戳
  startedAt DateTime @default(now())
  lastPing  DateTime @updatedAt
  metadata  String?  // JSON: { hostname, version, nodeEnv }

  @@index([lastPing])
}

// ===== 肌智派送好礼 · 活动系统 =====

// 活动/抽奖
model Campaign {
  id          String   @id @default(cuid())
  title       String                  // 活动标题，如"六月肌智派好礼"
  subtitle    String?                 // 副标题
  description String?                 // 活动描述/规则（Markdown）
  coverImage  String?                 // 活动封面图 URL
  status      String   @default("draft") // draft | active | ended
  startDate   DateTime
  endDate     DateTime
  prizes      Json                    // 奖品列表 [{name, image, quantity, description?}]
  shareText   String?                 // 小红书分享文案模板（支持 {{nickname}} 占位符）
  rules       String?                 // 活动规则（Markdown）
  maxEntries  Int      @default(0)    // 参与上限（0=不限制）
  drawDate    DateTime?               // 开奖时间（显示用）
  winnerIds   Json?                   // 中奖用户 entryId 数组
  sortOrder   Int      @default(0)    // 排序权重
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     CampaignEntry[]

  @@index([status, startDate])
  @@index([sortOrder])
}

// 活动参与记录
model CampaignEntry {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestId     String?                 // 游客标识（指纹）
  
  status      String   @default("pending") // pending | verified | rejected | won
  
  // 小红书分享凭证
  proofImage  String?                 // 用户上传的分享截图 OSS URL
  shareLink   String?                 // 用户提交的小红书分享链接
  
  // 抽奖相关
  lotteryCode String?  @unique        // 抽奖码（如 NPL-XXXX）
  prizeName   String?                 // 中奖奖品名
  
  // 提交人联系信息
  contactName  String?                // 中奖联系人姓名
  contactPhone String?                // 中奖联系人电话
  contactEmail String?                // 中奖联系人邮箱
  
  // 审核信息
  reviewerId   String?                // 审核人（AdminUser id）
  reviewNote   String?                // 审核备注
  reviewedAt   DateTime?
  verifiedAt   DateTime?
  
  // 中奖信息
  wonAt        DateTime?
  claimedAt    DateTime?              // 领奖时间
  claimNote    String?                // 领奖备注

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, userId])
  @@unique([campaignId, guestId])
  @@index([campaignId, status])
  @@index([userId])
  @@index([lotteryCode])
}

